# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On Streamlit Community Cloud, put the same keys in the app's Secrets (TOML: KEY = "value").
# Blank values fall back to the defaults in incident_suite/config.py.

# --- Models (OpenRouter) -------------------------------------------------
OPENROUTER_API_KEY=
# Must be in the allow-list in incident_suite/config.py
CLASSIFIER_MODEL=openai/gpt-4.1-mini
REMEDIATION_MODEL=openai/gpt-5-mini
# Blank: the Cookbook uses CLASSIFIER_MODEL
COOKBOOK_MODEL=
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Integrations --------------------------------------------------------
# Nothing is sent to Slack or JIRA unless this is true
# Run mode: true = Live (visitors: sample logs only, 1 ticket per run), false = Dry run
LIVE_INTEGRATIONS=false
# Pause for Approve / Reject in the app before any Slack or JIRA write
REQUIRE_APPROVAL=true

# Slack bot token (xoxb-...) with only the chat:write scope
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Jira Cloud
JIRA_BASE_URL=https://yourteam.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Task

# --- Tracing (optional) --------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=c10-g08

# --- Limits --------------------------------------------------------------
# 1 to 5: Streamlit itself refuses files over 5 MB
MAX_UPLOAD_MB=5
# 1 to 5
MAX_TICKETS_PER_RUN=3
RUN_TOKEN_BUDGET=200000

# --- Agent tuning ----------------------------------------------------------
# Log lines kept around each error (0 to 20)
CONTEXT_LINES=3
# Runbooks shown to Remediation (1 to 10)
RUNBOOK_TOP_K=3
# Below this confidence (0 to 1), Remediation tries once more
RETRY_CONFIDENCE=0.5

# --- Admin Console (optional) ---------------------------------------------
# Asked by Unlock on the settings pages. Unlocked sessions also skip the visitor
# guards on live runs. Without it the settings are read-only
ADMIN_PASSCODE=
